# 大语言模型通用配置
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 是否让 LLM 请求走本机系统代理（httpx trust_env）
# 默认为空/0 = 直连 LLM，刻意绕开 Windows 注册表里的系统代理，避免代理节点抖动
# 把每句请求打成 "SSL: UNEXPECTED_EOF_WHILE_READING" 进而变成 HTTP 500。
# 仅当你的网络环境必须经由代理访问 LLM 时才设为 1。
LLM_USE_SYSTEM_PROXY=

# 推送配置url
WECOM_WEBHOOK=

# 后端 CORS 允许的前端来源（逗号分隔，默认本机 7860 端口）
ALLOWED_ORIGINS=http://localhost:7860,http://127.0.0.1:7860